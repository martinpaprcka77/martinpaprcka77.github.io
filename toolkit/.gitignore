# Secrets and environment
config/secrets.*
*.secret
.env

# Toolkit config — LOCAL, never committed.
# Save-ToolkitConfig (called by ops/configure.ps1 and the `configure` menu item) writes
# config/settings.json. While that path was git-tracked, running the wizard dirtied the
# working tree and the next update.ps1 (`git pull --ff-only`) failed — or remote-install.ps1
# (`git reset --hard`) silently threw the user's settings away. config/settings.example.json
# is the committed template; Get-ToolkitConfig falls back to hardcoded defaults when no
# settings.json exists, so a fresh clone behaves identically.
config/settings.json
config/settings.json.backup

# Node
node_modules/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
# '.vscode/*', not '.vscode/' — see the note in the root .gitignore: excluding
# the directory itself makes the !negations below dead.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/agent-instructions.md
!.vscode/extensions.json
.idea/
*.sublime-*

# Generated
ops/profiles-fragment.json
icons/*.png
pwsh-health.json
